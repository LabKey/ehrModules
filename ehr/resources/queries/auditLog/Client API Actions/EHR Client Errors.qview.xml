        <column name="CreatedBy"/>
        <column name="Date"/>
        <column name="EventType"/>
        <column name="SubType"/>
        <column name="String1"/>
        <column name="Comment" />
    </columns>
    <filters>
        <filter column="SubType" operator="neqornull" value="LabKey Server Backup" />
    </filters>
   <sorts>
       <sort column="Date" descending="true"/>
   </sorts>
</customView>